# Copy to .env for local runs, and set the same variables in Railway.
ADMIN_PASSWORD=choose-a-long-password
SECRET_KEY=paste-output-of: python -c "import secrets; print(secrets.token_hex(32))"
# Railway provides DATABASE_URL automatically when you add PostgreSQL. Locally, SQLite is used if unset.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# Only needed if the frontend is hosted on a different domain (e.g. Vercel):
# CORS_ORIGINS=https://your-site.vercel.app
