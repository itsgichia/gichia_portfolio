const BASE = '/api'
const h = (token) => ({ 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) })
const tok = () => localStorage.getItem('pt')

export const getProfile = () => fetch(`${BASE}/profile`).then(r => r.json())
export const getProjects = () => fetch(`${BASE}/projects`).then(r => r.json())
export const login = async (pw) => {
  const r = await fetch(`${BASE}/login`, { method: 'POST', headers: h(), body: JSON.stringify({ password: pw }) })
  if (!r.ok) throw new Error('Invalid password')
  const d = await r.json(); localStorage.setItem('pt', d.token); return d
}
export const logout = () => { localStorage.removeItem('pt') }
export const isAdmin = () => !!tok()
export const createProject = (p) => fetch(`${BASE}/projects`, { method: 'POST', headers: h(tok()), body: JSON.stringify(p) }).then(r => r.json())
export const updateProject = (id, p) => fetch(`${BASE}/projects/${id}`, { method: 'PUT', headers: h(tok()), body: JSON.stringify(p) }).then(r => r.json())
export const deleteProject = (id) => fetch(`${BASE}/projects/${id}`, { method: 'DELETE', headers: h(tok()) }).then(r => r.json())
export const updateProfile = (p) => fetch(`${BASE}/profile`, { method: 'PUT', headers: h(tok()), body: JSON.stringify(p) }).then(r => r.json())
